# Sitenin genel adresi. Sitemap, robots, canonical, Open Graph ve bilet QR'ı bunu kullanır.
# Örnek: https://rastla.vercel.app
NEXT_PUBLIC_SITE_URL=

# Oturum çerezlerini imzalayan gizli anahtar. Üretimde mutlaka rastgele ve gizli olmalı.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# İşletme erişim kodları: isletme-kimligi:kod çiftleri, virgülle ayrılır.
# Tanımlı değilse işletme girişi kapalıdır.
OPERATOR_ACCESS_CODES=buyukcekmece-wsc:1234,mimarsinan-marina:5678

# SQLite dosyasının yolu (varsayılan: data/rastla.db)
# DİKKAT: SQLite Vercel'in sunucusuz ortamında kalıcı değildir; üretimde Postgres gerekir.
DATABASE_PATH=
