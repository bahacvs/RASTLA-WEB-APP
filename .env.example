# Sitenin genel adresi. Sitemap, robots, canonical, Open Graph ve bilet QR'ı bunu kullanır.
# Örnek: https://rastla.vercel.app
NEXT_PUBLIC_SITE_URL=

# Oturum çerezlerini imzalayan gizli anahtar. Üretimde mutlaka rastgele ve gizli olmalı.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# İşletme girişi artık ortam değişkeniyle yapılandırılmaz. Hesaplar kişiye
# özeldir ve veritabanında tutulur:
#   npm run seed                          -> ilk sahip hesabını üretir ve parolasını yazdırır
#   npm run operator:create -- list       -> mevcut hesapları listeler
#   npm run operator:create -- reset <e-posta>  -> parolayı sıfırlar
# Günlük ekip yönetimi uygulamadan yapılır: /isletme/ekip

# ÜRETİM İÇİN GEREKEN TEK ŞEY BUDUR.
# Tanımlıysa Postgres kullanılır; tanımsızsa yerel SQLite dosyası.
# DİKKAT: SQLite, Vercel'in sunucusuz ortamında KALICI DEĞİLDİR.
# Örnek: postgresql://kullanici:parola@host:5432/rastla
DATABASE_URL=

# TLS davranışı. Varsayılan: TLS kullanılır ama sertifika zinciri doğrulanmaz
# (barındırılan Postgres hizmetlerinin çoğu kendi zincirini sunar).
#   strict -> sertifika doğrulanır
#   off    -> TLS kapalı (yalnızca yerel geliştirme)
DATABASE_SSL=

# Postgres bağlantı havuzu üst sınırı (varsayılan 10).
DATABASE_POOL_MAX=

# SQLite dosyasının yolu (varsayılan: data/rastla.db). Yalnızca DATABASE_URL
# tanımlı DEĞİLKEN kullanılır.
DATABASE_PATH=
