# Pilot dönemi rezervasyon kanalı.
# İşletmenin/operasyonun WhatsApp numarası, uluslararası biçimde ve yalnızca rakam.
# Örnek: 905321234567
# Tanımlı değilse rezervasyon butonu "Yakında" olarak devre dışı kalır.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Sitenin genel adresi. WhatsApp mesajına aktivite bağlantısı eklemek için kullanılır.
# Örnek: https://rastla.vercel.app
NEXT_PUBLIC_SITE_URL=
