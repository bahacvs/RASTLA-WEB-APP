# Sitenin genel adresi. Sitemap, robots, canonical, Open Graph ve bilet QR'ı bunu kullanır.
# Örnek: https://rastla.vercel.app
NEXT_PUBLIC_SITE_URL=

# Oturum çerezlerini imzalayan gizli anahtar. Üretimde mutlaka rastgele ve gizli olmalı.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# İşletme girişi artık ortam değişkeniyle yapılandırılmaz. Hesaplar kişiye
# özeldir ve veritabanında tutulur:
#   npm run seed                          -> ilk sahip hesabını üretir ve parolasını yazdırır
#   npm run operator:create -- list       -> mevcut hesapları listeler
#   npm run operator:create -- reset <e-posta>  -> parolayı sıfırlar
# Günlük ekip yönetimi uygulamadan yapılır: /isletme/ekip

# ÜRETİM İÇİN GEREKEN TEK ŞEY BUDUR.
# Tanımlıysa Postgres kullanılır; tanımsızsa yerel SQLite dosyası.
# DİKKAT: SQLite, Vercel'in sunucusuz ortamında KALICI DEĞİLDİR.
# Örnek: postgresql://kullanici:parola@host:5432/rastla
DATABASE_URL=

# TLS davranışı. Varsayılan: TLS kullanılır ama sertifika zinciri doğrulanmaz
# (barındırılan Postgres hizmetlerinin çoğu kendi zincirini sunar).
#   strict -> sertifika doğrulanır
#   off    -> TLS kapalı (yalnızca yerel geliştirme)
DATABASE_SSL=

# Postgres bağlantı havuzu üst sınırı (varsayılan 10).
DATABASE_POOL_MAX=

# SQLite dosyasının yolu (varsayılan: data/rastla.db). Yalnızca DATABASE_URL
# tanımlı DEĞİLKEN kullanılır.
DATABASE_PATH=

# ---------------------------------------------------------------- giden mesaj
# Sağlayıcı anahtarı tanımsızsa mesaj GÖNDERİLMEZ, sunucu günlüğüne yazılır.
# Geliştirme ve doğrulama betikleri böylece hiçbir dış hesap gerektirmez.

# SMS — doğrulama kodları (müşteri rezervasyonu + işletme ikinci faktörü).
# TANIMSIZSA kodlar yalnızca sunucu günlüğüne yazılır ve KİMSEYE ULAŞMAZ;
# üretimde bu durumda başlatma uyarısı verilir. Netgsm için üçü de gerekir.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# E-posta — otomatik ihlal uyarıları. Resend anahtarı düz HTTP ile kullanılır.
RESEND_API_KEY=
MAIL_FROM=

# Uyarıların gideceği adresler, virgülle ayrılır (ihlal planındaki sorumlular).
#
# TANIMSIZSA `uyarilar` işi BAŞARISIZ sayılır ve zamanlayıcı hata görür.
# Bilinçli: uyarılar üretilip kimseye gitmemesi, bu fazın var olma sebebini
# ortadan kaldırırdı. Uyarılar yine de kaydedilir ve /isletme/gunluk üzerinde
# görünür; bir sonraki koşum göndermeyi tekrar dener.
ALERT_EMAIL_TO=

# ------------------------------------------------------------ zamanlanmış işler
# Zamanlayıcı ucunu (/api/gorevler/...) koruyan sır.
# TANIMSIZSA UÇ TAMAMEN KAPALIDIR — yapılandırmayı unutmak sessiz bir açığa
# dönüşmesin diye bilinçli olarak böyle. Üretmek için: openssl rand -base64 32
CRON_SECRET=

# Saklama süreleri (varsayılanlar politikadaki değerler).
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_RETENTION_HOURS=24

# ---------------------------------------------------------------- tanıtım
# DEMO_MODE=1 verildiğinde site GERÇEK BİR HİZMET GİBİ DAVRANMAZ:
#   - bütün sayfalar noindex olur, robots.txt her şeyi kapatır, sitemap boşalır
#   - her sayfanın üstünde "TANITIM SÜRÜMÜ" şeridi çıkar
#
# `node scripts/demo-seed.mjs` ile birlikte kullanılır: o betik uydurma
# işletmeler, uydurma ilanlar ve parolası bilinen hesaplar üretir.
#
# DİKKAT: robots.txt ve sitemap DERLEME ANINDA üretilir; bu değişkenin
# derleme sırasında da tanımlı olması gerekir (Vercel'de proje ayarına
# yazmak yeterli).
#
# Gerçek kullanıma geçerken BU DEĞİŞKENİ SİLİN ve demo hesaplarını askıya alın.
DEMO_MODE=

# --------------------------------------------------------------------- depo
# İşletmenin yüklediği aktivite görselleri.
#
# TANIMSIZSA dosya sistemi kullanılır (data/gorseller). Bu geliştirme için
# doğru, ÜRETİM İÇİN DEĞİL: Vercel'in sunucusuz ortamında yazılan dosya bir
# sonraki dağıtımda kaybolur — DATABASE_URL için geçerli uyarının aynısı.
BLOB_READ_WRITE_TOKEN=

# Blob anahtarı olsa bile dosya sistemini zorlamak için: local
STORAGE_PROVIDER=

# Yerel depo kökü (varsayılan: data/gorseller).
UPLOAD_PATH=

# --------------------------------------------------------------------- ödeme
# İKİSİ DE TANIMSIZSA ONLINE ÖDEME KAPALIDIR: rezervasyon eskisi gibi doğrudan
# onaylanır ve ücret deneyim yerinde alınır. Bu gerçek bir çalışma biçimi,
# yarım bir kurulum değil — şirket kurulup üye işyeri açılana kadar sistem
# çalışmaya devam etmeli.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Varsayılan sandbox. Üretim ucu için: IYZICO_SANDBOX=0
IYZICO_SANDBOX=

# YALNIZCA TEST. `fake` verildiğinde ödeme gerçekten alınmaz, akış taklit
# edilir. ÜRETİMDE ASLA TANIMLAMAYIN — ödeme almadan bilet üretmek demektir.
PAYMENT_PROVIDER=

# Ödemesi tamamlanmayan rezervasyonun düşürülüp kapasitesinin geri verileceği
# süre (dakika, varsayılan 20). `odeme-suresi` işi bunu kullanır.
PAYMENT_TIMEOUT_MINUTES=

# Müşteri iptalinde tam iade eşiği (saat, varsayılan 24). Aktiviteye bu
# süreden az kalmışsa iade yapılmaz.
# DİKKAT: bu değer ön bilgilendirme formunda yazan süreyle AYNI olmalı;
# farklı olursa formdaki taahhüt geçerli sayılır.
FREE_CANCELLATION_HOURS=

# ---------------------------------------------------------------- Partner

# İşletme başvurularının gideceği adres — /partner sayfasındaki düğmeler
# buraya yazıyor. TANIMSIZSA düğmeler `partner@ornek.com` adresine yazar ve
# gelen mesajlar HİÇBİR YERE ULAŞMAZ. Sayfa yayına alınmadan önce doldurun.
PARTNER_CONTACT_EMAIL=

# Hak ediş ekranında görünen aktarım takvimi cümlesi, örn:
# "Hak edilen tutarlar her salı hesabınıza aktarılır."
# Tanımsızsa ekranda "takvim henüz belirlenmedi" yazar. Uydurma bir tarih
# göstermek, tutamayacağımız bir söz vermek olurdu.
PAYOUT_SCHEDULE=

# `1` verilirse komisyon göçü atlanır: eski varsayılandaki (%10) işletmeler
# yeni varsayılana (%18) taşınmaz. Yürürlükteki ticari sözleşmesi eski oranı
# yazan kurulumlar için.
RASTLA_KEEP_COMMISSION=
